# Required in production. Your admin login password (local dev defaults to "admin").
ADMIN_PASSWORD=

# Optional. Signs the login cookie. If empty, one is derived from ADMIN_PASSWORD.
AUTH_SECRET=

# Postgres connection string for analytics. Added automatically when you connect Neon in Vercel → Storage.
DATABASE_URL=

# Added automatically when you connect a Blob store in Vercel → Storage.
BLOB_READ_WRITE_TOKEN=
